# SkyCast Operational Environment Configuration
# Copy this file to .env and adjust values as needed.
# DO NOT commit .env files containing real secret tokens.

# ==============================================================================
# OPERATIONAL LIVE FORECASTING CONFIGURATION
# ==============================================================================
LIVE_MODE=false
LIVE_PROVIDER=open_meteo
LIVE_API_BASE_URL=https://api.open-meteo.com/v1/forecast
LIVE_DEFAULT_LATITUDE=19.0760
LIVE_DEFAULT_LONGITUDE=72.8777
LIVE_DEFAULT_LOCATION_NAME=Mumbai, India

# Refresh & Staleness Thresholds (Minutes)
LIVE_REFRESH_MINUTES=15
LIVE_FRESH_THRESHOLD_MINUTES=60
LIVE_STALE_THRESHOLD_MINUTES=180
LIVE_CACHE_MAX_AGE_MINUTES=1440
LIVE_MAX_CACHE_FILES=24

# Network Timeouts & Retries
LIVE_REQUEST_TIMEOUT_SECONDS=10.0
LIVE_MAX_RETRIES=3
LIVE_RETRY_BACKOFF_FACTOR=1.5

# Extreme Weather Alert Thresholds
HEAVY_RAIN_THRESHOLD_6H_MM=15.0
EXTREME_RAIN_THRESHOLD_6H_MM=35.0
HIGH_WIND_THRESHOLD_MS=17.2
HIGH_TEMP_THRESHOLD_C=40.0
COLD_TEMP_THRESHOLD_C=5.0
